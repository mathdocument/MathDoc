#!/usr/bin/env python3
"""Run the same checks locally and in CI: check [all|fast|native|docker].

fast    type checks, unit tests, builds, documentation site, LaTeX renderer
native  backend and browser tests against disposable TerminusDB and PostgreSQL
docker  build the runtime image and test an exported deployment

Tests that need LeanGround run only when MDC_TEST_LEANGROUND_URL / LEANGROUND_SERVER_URL
point at one; they skip otherwise.
"""
import argparse
import http.client
import os
from pathlib import Path
import secrets
import socket
import subprocess
import time
import urllib.request


REPO = Path(__file__).resolve().parents[1]


def run(*command, env=None, capture=False):
    print("+", " ".join(map(str, command)), flush=True)
    return subprocess.run(command, cwd=REPO, env=env, check=True, text=True,
                          stdout=subprocess.PIPE if capture else None).stdout


def free_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def fast(python):
    tracked = run("git", "ls-files", "--", "web/dist", "docs/dist", "coordinator/dist",
                  "node_modules", "web/node_modules", "docs/node_modules", "mathdoc.env",
                  "secrets", capture=True)
    if tracked.strip():
        raise RuntimeError(f"Generated files or deployment state tracked in Git:\n{tracked}")
    run("npm", "ci")
    run("npm", "run", "check")
    run("npm", "run", "check", "-w", "mdc-web")
    run("npm", "test", "-w", "mdc-web")
    run("npm", "run", "build", "-w", "@mathdoc/coordinator")
    run("npm", "run", "build", "-w", "mdc-web")
    run("npm", "--prefix", "docs", "ci")
    run("npm", "--prefix", "docs", "run", "check")
    run("npm", "--prefix", "docs", "run", "build")
    run(python, "-B", "-m", "unittest", "discover", "-s", "renderer", "-p", "test_*.py")


def native(python):
    run("npm", "exec", "-w", "mdc-web", "--", "playwright", "install", "--no-shell", "chromium")
    # Always use disposable databases, even when a developer runs a live deployment here.
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("MDC_", "MATHDOC_", "COMPOSE_"))
           or k.startswith(("MDC_TEST_LEANGROUND", "MDC_TEST_MATHLIB", "MDC_E2E_"))}
    terminus_port, postgres_port = free_port(), free_port()
    password = secrets.token_hex(32)
    env.update(COMPOSE_PROJECT_NAME="mathdoc-check-" + secrets.token_hex(4),
               MDC_TERMINUS_PORT=str(terminus_port), MDC_POSTGRES_PORT=str(postgres_port),
               MDC_TERMINUS_PASSWORD=password, MDC_POSTGRES_PASSWORD=password,
               MDC_LATEX_PYTHON=python)
    database = f"postgresql://mathdoc:{password}@127.0.0.1:{postgres_port}/mathdoc"
    terminus = f"http://127.0.0.1:{terminus_port}"
    compose = ("docker", "compose", "-f", str(REPO / "compose.yaml"))
    try:
        run(*compose, "up", "-d", "--pull", "missing", env=env)
        for _ in range(90):
            try:
                with urllib.request.urlopen(terminus + "/api/ok", timeout=1):
                    pass
                subprocess.run([*compose, "exec", "-T", "postgres", "pg_isready", "-U", "mathdoc"],
                               cwd=REPO, env=env, check=True, capture_output=True)
                break
            except (OSError, http.client.HTTPException, subprocess.CalledProcessError):
                time.sleep(1)
        else:
            raise RuntimeError("Test TerminusDB/PostgreSQL did not become ready")
        # Test files share one TerminusDB server registry: run them one at a time.
        run("npx", "tsx", "--test", "--test-concurrency=1", "coordinator/test/*.test.ts",
            env={**env, "MDC_TEST_DATABASE_URL": database, "MDC_TEST_TERMINUS_URL": terminus,
                 "MDC_TEST_TERMINUS_PASSWORD": password})
        run("npm", "run", "test:e2e", "-w", "mdc-web",
            env={**env, "MDC_DATABASE_URL": database, "MDC_TERMINUS_URL": terminus})
    except BaseException:
        subprocess.run([*compose, "logs", "--no-color", "--tail", "80"], cwd=REPO, env=env)
        raise
    finally:
        run(*compose, "down", "--volumes", "--remove-orphans", env=env)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("suite", nargs="?", default="all", choices=("all", "fast", "native", "docker"))
    args = parser.parse_args()
    python = os.environ.get("MDC_LATEX_PYTHON", "python3")
    if args.suite in ("all", "fast", "native"):
        fast(python)
    if args.suite in ("all", "native"):
        native(python)
    if args.suite in ("all", "docker"):
        run("docker", "build", "-t", "mathdoc-runtime:local", ".")
        run("python3", "tests/docker-smoke.py")
    print(f"Checks passed: {args.suite}", flush=True)


if __name__ == "__main__":
    main()
