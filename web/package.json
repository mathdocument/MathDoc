{
  "name": "mdc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --project tsconfig.scripts.json",
    "test": "vitest run",
    "perf": "npm run build && node perf/run.ts",
