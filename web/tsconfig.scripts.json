{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "erasableSyntaxOnly": true
  },
  "include": ["perf/**/*.ts", "e2e/**/*.ts"]
}
