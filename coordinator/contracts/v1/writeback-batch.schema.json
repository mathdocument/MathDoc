{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mathdoc.writeback-batch.v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "replay_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "review_branch": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "data_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "database",
        "branch",
        "data_version"
      ],
      "additionalProperties": false
    },
    "source_proof_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "update_lean_block",
              "create_definition_node",
              "create_goal_node"
            ]
          },
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_node_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "certification_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "definition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "preserve_public_declaration_name": {
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "kind",
          "node_id",
          "source_sha256",
          "preserve_public_declaration_name"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "update_lean_block"
                }
              }
            },
            "then": {
              "required": [
                "expected_node_revision",
                "certification_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "create_definition_node"
                }
              }
            },
            "then": {
              "required": [
                "definition_id"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "conflict_resolution": {
      "type": "string",
      "const": "abort_entire_batch"
    },
    "certification_visibility": {
      "type": "string",
      "const": "after_full_batch_commit"
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "replay_key",
    "review_branch",
    "source_proof_request_id",
    "operations",
    "conflict_resolution",
    "certification_visibility"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathdoc.local/contracts/v1/writeback-batch.schema.json"
}
