{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "mathdoc.declaration-binding.v1-draft"
        },
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "block_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_context": {
          "type": "object",
          "properties": {
            "raw": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "local_options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "universes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "opens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "local_notation": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "local_attrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "string",
          "const": "definition_only"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "declaration_kind": {
                "type": "string",
                "enum": [
                  "def",
                  "abbrev",
                  "noncomputable_def",
                  "structure",
                  "inductive"
                ]
              },
              "dependency_definition_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "definition_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "name",
              "declaration_kind",
              "dependency_definition_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "node_id",
        "block_revision",
        "source_sha256",
        "required_context",
        "classification",
        "definitions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "mathdoc.declaration-binding.v1-draft"
        },
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "block_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_context": {
          "type": "object",
          "properties": {
            "raw": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "local_options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "universes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "opens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "local_notation": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "local_attrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "string",
          "const": "theorem"
        },
        "conclusion": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "declaration_kind": {
              "type": "string",
              "enum": [
                "theorem",
                "lemma"
              ]
            },
            "goal": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "name",
            "declaration_kind"
          ],
          "additionalProperties": false
        },
        "premise_placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "declaration_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "node_id": {
                "type": "string",
                "format": "uuid"
              },
              "goal": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "declaration_name",
              "node_id",
              "goal"
            ],
            "additionalProperties": false
          }
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "new_definitions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "component": {
          "type": "string",
          "enum": [
            "lean-worker",
            "lean-worker-sketch"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "leaf",
            "sketch"
          ]
        }
      },
      "required": [
        "schema_version",
        "node_id",
        "block_revision",
        "source_sha256",
        "required_context",
        "classification",
        "conclusion",
        "premise_placeholders",
        "definitions",
        "new_definitions",
        "component",
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sketch"
              }
            }
          },
          "then": {
            "properties": {
              "component": {
                "const": "lean-worker-sketch"
              },
              "premise_placeholders": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "component": {
                "const": "lean-worker"
              },
              "premise_placeholders": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "new_definitions": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "conclusion": {
                "required": [
                  "goal"
                ]
              }
            }
          }
        }
      ],
      "$comment": "Semantic validation also requires unique premise declaration names, distinct from conclusion.name; failure is unsupported/premise_name_collision. Required context must match the fixed ProofRequest context per contracts.ts."
    },
    {
      "type": "object",
