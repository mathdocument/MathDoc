{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathdoc.local/contracts/v1/declaration-binding.schema.json",
  "title": "MathDoc declaration binding contract v1 draft",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "node_id", "block_revision", "source_sha256", "classification", "definitions"],
      "properties": {
        "schema_version": { "const": "mathdoc.declaration-binding.v1-draft" },
        "node_id": { "type": "string", "format": "uuid" },
        "block_revision": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "classification": { "const": "definition_only" },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "declaration_kind", "dependency_definition_ids"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "declaration_kind": { "enum": ["def", "abbrev", "noncomputable_def", "structure", "inductive"] },
              "dependency_definition_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "definition_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "node_id", "block_revision", "source_sha256", "classification", "conclusion", "premise_placeholders", "definitions", "new_definitions", "component", "mode"],
      "properties": {
        "schema_version": { "const": "mathdoc.declaration-binding.v1-draft" },
        "node_id": { "type": "string", "format": "uuid" },
        "block_revision": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "classification": { "const": "theorem" },
        "conclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "declaration_kind"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "declaration_kind": { "enum": ["theorem", "lemma"] },
            "goal": { "type": "object" }
          }
        },
        "premise_placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["declaration_name", "node_id", "goal"],
            "properties": {
              "declaration_name": { "type": "string", "minLength": 1 },
              "node_id": { "type": "string", "format": "uuid" },
              "goal": { "type": "object" }
            }
          }
        },
        "definitions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "new_definitions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "component": { "enum": ["lean-worker", "lean-worker-sketch"] },
        "mode": { "enum": ["leaf", "sketch"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "node_id", "block_revision", "source_sha256", "classification", "reason", "details"],
      "properties": {
        "schema_version": { "const": "mathdoc.declaration-binding.v1-draft" },
        "node_id": { "type": "string", "format": "uuid" },
        "block_revision": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "classification": { "const": "unsupported" },
        "reason": { "enum": ["multiple_conclusions", "mixed_declarations", "unsupported_declaration", "unregistered_statement_definition", "missing_environment_instance", "ambiguous_binding"] },
        "details": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
